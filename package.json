{
  "name": "language-tutor-mcp",
  "version": "1.0.0",
  "description": "Remote MCP server that gives an AI language tutor a long-term memory (Cloudflare Workers + D1, or local SQLite)",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "syllabus:validate": "node scripts/syllabus-validate.ts --out build",
    "syllabus:import": "node scripts/syllabus-import.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "user:add": "node scripts/user-add.ts",
    "local:exec": "node dist/local-exec.mjs",
    "test:sqlite": "TEST_DB=sqlite vitest run",
    "build:local": "esbuild src/local.ts scripts/local-exec.ts --bundle --platform=node --format=esm --target=node22 --external:node:sqlite --outdir=dist --out-extension:.js=.mjs --entry-names=[name]",
    "local": "node dist/local.mjs"
  },
  "keywords": [],
  "author": "Viktoras Bezaras",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "agents": "^0.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "miniflare": "^4.20260730.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0",
    "yaml": "^2.9.1"
  }
}
